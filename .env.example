# Copy to backend/.env (never commit the real file)
# Enables LIVE LLM mode for profile analysis + agent dates.
# Without LLM_API_KEY the app runs in explicitly labeled scripted demo mode.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: override SQLite location (default: backend/pairwise.db)
# DATABASE_URL=/path/to/pairwise.db

# Frontend (frontend/.env): where the UI finds the API
# VITE_API_URL=http://localhost:8000
