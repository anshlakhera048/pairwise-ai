# Copy to .env and fill in. Never commit .env.
# OpenAI-compatible chat completions endpoint for profile analysis + agent dates.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# SQLite file. Supports sqlite:///absolute/path or plain path. Default: backend/pairwise.db
DATABASE_URL=
